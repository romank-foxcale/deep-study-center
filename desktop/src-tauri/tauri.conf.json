{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deep Study Center",
  "version": "0.7.0",
  "identifier": "app.deepstudycenter.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deep Study Center",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/dist/dsc-backend/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1NEVGNkM1ODFDMzJDNTUKUldSVkxNT0J4ZlpPSmZ2cFZ1R0c0RG5xS2lFMzlEYnFVd1FCeHg5RDhZbFhuckxOU2RJdkVXZ3EK",
      "endpoints": [
        "https://github.com/romank-foxcale/deep-study-center/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
